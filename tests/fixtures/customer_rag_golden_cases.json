      "relevant": [["长辈"], ["生日"], ["甜度"], ["少糖"]],
      "guardrails": [
        "优先推荐稳重寓意明确的款式",
        "不能推荐知识库未命中的具体商品名"
      ]
    },
    {
      "id": "customer-delivery-001",
      "group": "delivery",
