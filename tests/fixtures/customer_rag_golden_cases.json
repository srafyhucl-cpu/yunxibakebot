      "relevant": [["配送"], ["运费"], ["同城"]],
      "guardrails": [
        "默认先回答同城配送与到店自提",
        "不能承诺一定准时送达"
      ]
    },
    {
      "id": "customer-delivery-002",
      "group": "delivery",
      "query": "可以寄到外地吗",
      "intent": "faq_delivery",
      "relevant": [["外地"], ["快递"], ["跨城"]],
      "guardrails": [
        "只有顾客明确问外地或快递时才补充外地规则",
        "资料不足时引导人工确认"
      ]
    },
    {
      "id": "customer-refund-001",
      "group": "refund_after_sales",
      "query": "我下错单了，可以取消退款吗",
      "intent": "faq_after_sales",
      "relevant": [["取消"], ["退款"], ["售后"], ["改单"]],
      "guardrails": [
        "先安抚并收集订单信息",
        "不能直接承诺退款、补发或赔付"
      ]
    },
    {
      "id": "customer-refund-002",
      "group": "refund_after_sales",
      "query": "蛋糕收到有问题，怎么处理",
      "intent": "faq_after_sales",
      "relevant": [["售后"], ["照片"], ["订单号"], ["投诉"]],
      "guardrails": [
        "需要收集订单号、照片或视频、收货时间",
        "复杂售后必须转人工"
      ]
    },
    {
      "id": "customer-transfer-001",
      "group": "human_transfer",
      "query": "我要找人工客服处理一下",
      "intent": "human_transfer",
      "relevant": [["转人工"], ["人工"], ["客服"]],
      "guardrails": [
