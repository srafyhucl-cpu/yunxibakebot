{
  "meta": {
    "name": "芸熙烘焙客户机器人 RAG golden cases",
    "purpose": "固定客户侧高频客服问法，用于后续检索、知识库治理和回复守卫的离线回归。",
    "version": "1",
    "updated": "2026-07-06",
    "required_groups": [
      "product_consultation",
      "delivery",
      "refund_after_sales",
      "human_transfer"
    ],
    "match_rule": "每条 case 的 relevant 是一组关键词匹配器。召回知识的 title + content 命中任一匹配器中的全部关键词，即认为该 case 有目标知识。"
  },
  "cases": [
    {
      "id": "customer-product-001",
      "group": "product_consultation",
      "query": "想订一个六寸生日蛋糕，大概多少钱，够几个人吃",
      "intent": "product_consultation",
      "relevant": [["生日", "蛋糕"], ["尺寸", "食用人数"], ["价格"]],
      "guardrails": [
        "只能依据知识库或商品实时数据报价",
        "尺寸和食用人数查不到时必须建议咨询人工确认"
      ]
    },
    {
      "id": "customer-product-002",
      "group": "product_consultation",
      "query": "有没有适合长辈生日的蛋糕，别太甜",
