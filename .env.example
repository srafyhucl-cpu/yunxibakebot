# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 有赞云
YOUZAN_CLIENT_ID=your-client-id
YOUZAN_CLIENT_SECRET=your-client-secret
YOUZAN_KDT_ID=your-kdt-id
YOUZAN_WEBHOOK_TOKEN=your-webhook-token

# 企业微信（第二阶段启用）
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret
WECOM_TOKEN=your-wecom-token
WECOM_ENCODING_AES_KEY=your-aes-key

# 管理后台
ADMIN_API_TOKEN=your-admin-token

# 服务配置
SERVER_HOST=127.0.0.1
SERVER_PORT=7001
LOG_LEVEL=info
